@model IEnumerable<Inmueble>
@{
    ViewData["Title"] = "Gestión de Inmuebles";
}

<div class="container">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Gestión de Inmuebles</h2>
        <a asp-action="CrearInmueble" class="btn btn-primary">
            <i class="bi bi-plus-circle"></i> Crear Inmueble
        </a>
    </div>

    <div class="table-responsive">
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>Código</th>
                    <th>Título</th>
                    <th>Tipo</th>
                    <th>Ciudad</th>
                    <th>Precio</th>
                    <th>Estado</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var inmueble in Model)
                {
                    <tr>
                        <td><strong>@inmueble.Codigo</strong></td>
                        <td>@inmueble.Titulo</td>
                        <td>@inmueble.Tipo</td>
                        <td>@inmueble.Ciudad</td>
                        <td>$@inmueble.Precio.ToString("N0")</td>
                        <td>
                            <span class="badge @(inmueble.Activo ? "bg-success" : "bg-secondary")">
                                @(inmueble.Activo ? "Activo" : "Inactivo")
                            </span>
                        </td>
                        <td>
                            <div class="btn-group btn-group-sm">
                                <a asp-action="EditarInmueble" asp-route-id="@inmueble.Id"
                                   class="btn btn-outline-primary">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <form asp-action="CambiarEstado" method="post" class="d-inline">
                                    <input name="id" type="hidden" value="@inmueble.Id" />
                                    <button type="submit" class="btn @(inmueble.Activo ? "btn-outline-warning" : "btn-outline-success")"
                                            onclick="return confirm('¿Cambiar estado del inmueble?')">
                                        <i class="bi @(inmueble.Activo ? "bi-pause" : "bi-play")"></i>
                                    </button>
                                </form>
                                <a asp-controller="Catalogo" asp-action="Detalle" asp-route-id="@inmueble.Id"
                                   class="btn btn-outline-info" target="_blank">
                                    <i class="bi bi-eye"></i>
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info text-center">
            <i class="bi bi-info-circle"></i> No hay inmuebles registrados.
            <a asp-action="CrearInmueble" class="alert-link">Crear el primero</a>
        </div>
    }
</div>
