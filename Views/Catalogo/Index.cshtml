@model CatalogoViewModel
@{
    ViewData["Title"] = "Catálogo de Inmuebles";
}

<div class="container">
    @* Alertas de sesión y caché *@
    @if (ViewBag.FiltrosRecuperados == true)
    {
        <div class="alert alert-info alert-dismissible fade show" role="alert">
            <i class="bi bi-info-circle"></i> Se han recuperado tus últimos filtros utilizados.
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (ViewBag.DesdCache == true)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-lightning"></i> Resultados obtenidos desde caché (carga rápida).
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="row">
        <div class="col-12">
            <h1 class="mb-4">
                <i class="bi bi-house-door"></i> Catálogo de Inmuebles
            </h1>
        </div>
    </div>

    <!-- Filtros -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">
                        <i class="bi bi-funnel"></i> Filtros de búsqueda
                    </h5>
                </div>
                <div class="card-body">
                    <form method="get" asp-action="Index">
                        <div class="row g-3">
                            <div class="col-md-3">
                                <label asp-for="Ciudad" class="form-label">Ciudad</label>
                                <input asp-for="Ciudad" class="form-control" placeholder="Ej: Lima" />
                                <span asp-validation-for="Ciudad" class="text-danger"></span>
                            </div>

                            <div class="col-md-3">
                                <label asp-for="Tipo" class="form-label">Tipo de inmueble</label>
                                <select asp-for="Tipo" class="form-select">
                                    <option value="">Todos los tipos</option>
                                    <option value="0">Departamento</option>
                                    <option value="1">Casa</option>
                                    <option value="2">Oficina</option>
                                    <option value="3">Local</option>
                                </select>
                            </div>

                            <div class="col-md-2">
                                <label asp-for="PrecioMin" class="form-label">Precio mínimo</label>
                                <input asp-for="PrecioMin" type="number" class="form-control" min="0" step="1000" placeholder="0" />
                                <span asp-validation-for="PrecioMin" class="text-danger"></span>
                            </div>

                            <div class="col-md-2">
                                <label asp-for="PrecioMax" class="form-label">Precio máximo</label>
                                <input asp-for="PrecioMax" type="number" class="form-control" min="0" step="1000" placeholder="999999" />
                                <span asp-validation-for="PrecioMax" class="text-danger"></span>
                            </div>

                            <div class="col-md-2">
                                <label asp-for="Dormitorios" class="form-label">Dormitorios mín.</label>
                                <input asp-for="Dormitorios" type="number" class="form-control" min="0" max="10" placeholder="0" />
                                <span asp-validation-for="Dormitorios" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="row mt-3">
                            <div class="col-12">
                                <button type="submit" class="btn btn-primary me-2">
                                    <i class="bi bi-search"></i> Buscar
                                </button>
                                <a asp-action="Index" class="btn btn-outline-secondary me-2">
                                    <i class="bi bi-x-circle"></i> Limpiar filtros
                                </a>
                                @if (User.IsInRole("Broker"))
                                {
                                    <a asp-action="InvalidarCache" class="btn btn-outline-warning">
                                        <i class="bi bi-arrow-clockwise"></i> Limpiar caché
                                    </a>
                                }
                            </div>
                        </div>

                        <!-- Mostrar errores de validación -->
                        <div asp-validation-summary="All" class="text-danger mt-2"></div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <!-- Información de resultados -->
    <div class="row">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h4>
                    @if (Model.Inmuebles.Any())
                    {
                        <span class="text-success">
                            <i class="bi bi-check-circle"></i>
                            Se encontraron @Model.Inmuebles.Count inmuebles
                        </span>
                    }
                    else
                    {
                        <span class="text-muted">
                            <i class="bi bi-exclamation-circle"></i>
                            No se encontraron inmuebles
                        </span>
                    }
                </h4>

                @if (Model.TotalPaginas > 1)
                {
                    <small class="text-muted">
                        <i class="bi bi-files"></i>
                        Página @Model.Pagina de @Model.TotalPaginas
                    </small>
                }
            </div>
        </div>
    </div>

    <!-- Lista de inmuebles -->
    @if (Model.Inmuebles.Any())
    {
        <div class="row">
            @foreach (var inmueble in Model.Inmuebles)
            {
                <div class="col-lg-4 col-md-6 mb-4">
                    <div class="card h-100 shadow-sm hover-card">
                        @if (!string.IsNullOrEmpty(inmueble.Imagen))
                        {
                            <img src="@inmueble.Imagen" class="card-img-top" style="height: 200px; object-fit: cover;" alt="@inmueble.Titulo" />
                        }
                        else
                        {
                            <div class="card-img-top bg-light d-flex align-items-center justify-content-center" style="height: 200px;">
                                <i class="bi bi-house-door text-muted" style="font-size: 3rem;"></i>
                            </div>
                        }

                        <div class="card-body d-flex flex-column">
                            <h5 class="card-title">@inmueble.Titulo</h5>

                            <div class="mb-2">
                                <span class="badge bg-primary">
                                    <i class="bi bi-tag"></i> @inmueble.Tipo
                                </span>
                                <small class="text-muted ms-2">
                                    <i class="bi bi-geo-alt"></i> @inmueble.Ciudad
                                </small>
                            </div>

                            <p class="card-text text-muted">
                                <i class="bi bi-map"></i> @inmueble.Direccion
                            </p>

                            <div class="row text-center mb-3">
                                <div class="col-4">
                                    <div class="text-center">
                                        <i class="bi bi-door-open text-primary"></i>
                                        <br><small class="text-muted">Dormitorios</small>
                                        <br><strong>@inmueble.Dormitorios</strong>
                                    </div>
                                </div>
                                <div class="col-4">
                                    <div class="text-center">
                                        <i class="bi bi-droplet text-primary"></i>
                                        <br><small class="text-muted">Baños</small>
                                        <br><strong>@inmueble.Banos</strong>
                                    </div>
                                </div>
                                <div class="col-4">
                                    <div class="text-center">
                                        <i class="bi bi-rulers text-primary"></i>
                                        <br><small class="text-muted">m²</small>
                                        <br><strong>@inmueble.MetrosCuadrados</strong>
                                    </div>
                                </div>
                            </div>

                            <div class="mt-auto">
                                <div class="d-flex justify-content-between align-items-center">
                                    <h4 class="text-success mb-0">
                                        <i class="bi bi-currency-dollar"></i>@inmueble.Precio.ToString("N0")
                                    </h4>
                                    <a asp-action="Detalle" asp-route-id="@inmueble.Id" class="btn btn-primary">
                                        <i class="bi bi-eye"></i> Ver detalles
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        <!-- Paginación -->
        @if (Model.TotalPaginas > 1)
        {
            <nav aria-label="Paginación del catálogo" class="mt-4">
                <ul class="pagination justify-content-center">
                    @* Página anterior *@
                    @if (Model.Pagina > 1)
                    {
                        <li class="page-item">
                            <a class="page-link"
                               asp-action="Index"
                               asp-route-pagina="@(Model.Pagina - 1)"
                               asp-route-ciudad="@Model.Ciudad"
                               asp-route-tipo="@Model.Tipo"
                               asp-route-precioMin="@Model.PrecioMin"
                               asp-route-precioMax="@Model.PrecioMax"
                               asp-route-dormitorios="@Model.Dormitorios">
                                <i class="bi bi-chevron-left"></i> Anterior
                            </a>
                        </li>
                    }

                    @* Números de página (mostrar máximo 5 páginas) *@
                    @{
                        var startPage = Math.Max(1, Model.Pagina - 2);
                        var endPage = Math.Min(Model.TotalPaginas, Model.Pagina + 2);
                    }

                    @if (startPage > 1)
                    {
                        <li class="page-item">
                            <a class="page-link"
                               asp-action="Index"
                               asp-route-pagina="1"
                               asp-route-ciudad="@Model.Ciudad"
                               asp-route-tipo="@Model.Tipo"
                               asp-route-precioMin="@Model.PrecioMin"
                               asp-route-precioMax="@Model.PrecioMax"
                               asp-route-dormitorios="@Model.Dormitorios">1</a>
                        </li>
                        @if (startPage > 2)
                        {
                            <li class="page-item disabled">
                                <span class="page-link">...</span>
                            </li>
                        }
                    }

                    @for (int i = startPage; i <= endPage; i++)
                    {
                        <li class="page-item @(i == Model.Pagina ? "active" : "")">
                            <a class="page-link"
                               asp-action="Index"
                               asp-route-pagina="@i"
                               asp-route-ciudad="@Model.Ciudad"
                               asp-route-tipo="@Model.Tipo"
                               asp-route-precioMin="@Model.PrecioMin"
                               asp-route-precioMax="@Model.PrecioMax"
                               asp-route-dormitorios="@Model.Dormitorios">
                                @i
                            </a>
                        </li>
                    }

                    @if (endPage < Model.TotalPaginas)
                    {
                        @if (endPage < Model.TotalPaginas - 1)
                        {
                            <li class="page-item disabled">
                                <span class="page-link">...</span>
                            </li>
                        }
                        <li class="page-item">
                            <a class="page-link"
                               asp-action="Index"
                               asp-route-pagina="@Model.TotalPaginas"
                               asp-route-ciudad="@Model.Ciudad"
                               asp-route-tipo="@Model.Tipo"
                               asp-route-precioMin="@Model.PrecioMin"
                               asp-route-precioMax="@Model.PrecioMax"
                               asp-route-dormitorios="@Model.Dormitorios">@Model.TotalPaginas</a>
                        </li>
                    }

                    @* Página siguiente *@
                    @if (Model.Pagina < Model.TotalPaginas)
                    {
                        <li class="page-item">
                            <a class="page-link"
                               asp-action="Index"
                               asp-route-pagina="@(Model.Pagina + 1)"
                               asp-route-ciudad="@Model.Ciudad"
                               asp-route-tipo="@Model.Tipo"
                               asp-route-precioMin="@Model.PrecioMin"
                               asp-route-precioMax="@Model.PrecioMax"
                               asp-route-dormitorios="@Model.Dormitorios">
                                Siguiente <i class="bi bi-chevron-right"></i>
                            </a>
                        </li>
                    }
                </ul>
            </nav>
        }
    }
    else
    {
        <div class="row">
            <div class="col-12">
                <div class="alert alert-info text-center py-5">
                    <i class="bi bi-info-circle fs-1 text-muted"></i>
                    <h4 class="mt-3">No se encontraron inmuebles</h4>
                    <p class="mb-3">Intenta ajustar los filtros de búsqueda para obtener más resultados.</p>
                    <a asp-action="Index" class="btn btn-primary">
                        <i class="bi bi-arrow-clockwise"></i> Ver todos los inmuebles
                    </a>
                </div>
            </div>
        </div>
    }
</div>

@* CSS adicional para efectos hover *@
<style>
    .hover-card {
        transition: transform 0.2s ease-in-out, box-shadow 0.2s ease-in-out;
    }

        .hover-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 4px 20px rgba(0,0,0,0.1) !important;
        }

    .card-img-top {
        transition: transform 0.3s ease;
    }

    .hover-card:hover .card-img-top {
        transform: scale(1.05);
    }
</style>